# Development / REHEARSAL only. Build with --platform linux/amd64.
ARG NODE_IMAGE=docker.io/library/node@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
ARG RUNTIME_IMAGE=cgr.dev/chainguard/node@sha256:0d0e3c2b91b1c82c125052fc4dd0fe22294b13e22c5210ebc94955bdfd5fe2d3
FROM ${NODE_IMAGE} AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY server ./server
COPY contracts ./contracts
RUN npm run build:server

FROM ${RUNTIME_IMAGE}
ARG SOURCE_REVISION
ARG SOURCE_DIRTY=true
LABEL org.opencontainers.image.title="Sovereign AI 101 governed rehearsal service" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.sovereign.source-dirty="${SOURCE_DIRTY}" \
      io.sovereign.delivery="development" \
      io.sovereign.source="REHEARSAL"
WORKDIR /app
COPY --from=build /build/server/dist/server ./server/dist/server
COPY --from=build /build/server/dist/contracts/governed-inference.js ./server/dist/contracts/governed-inference.js
COPY package.json ./package.json
COPY packaging/runtime/config.mjs packaging/runtime/healthcheck.mjs packaging/runtime/service.mjs ./packaging/runtime/
ENV NODE_ENV=production PORT=8787 SOVEREIGN_SOURCE=REHEARSAL DELIVERY_STATUS=development
USER 65532:65532
EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=4s --start-period=10s --retries=3 CMD ["/usr/bin/node", "packaging/runtime/healthcheck.mjs"]
CMD ["packaging/runtime/service.mjs"]
