{
  "name": "sovereign-ai-101",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:server": "npm run build:server && node server/dist/server/index.js",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test:server": "npm run build:server && node --test server/dist/contracts/runtime.node-test.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:visual": "playwright test",
    "verify:offline": "node scripts/verify-offline.mjs",
    "check:app": "npm run test && npm run build && npm run verify:offline",
    "check:lab": "npm --prefix showroom run check",
    "check": "npm run check:app && npm run test:server && npm run typecheck:server && npm run check:lab && npm run check:packaging",
    "preview": "vite preview",
    "check:packaging": "npm run build:server && npm run build && node packaging/scripts/validate.mjs && node --test packaging/tests/*.test.mjs",
    "validate:packaging": "node packaging/scripts/validate.mjs",
    "build:images": "node packaging/scripts/build.mjs",
    "dev:packaging": "node packaging/scripts/dev.mjs",
    "render:openshift": "node packaging/scripts/render.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.12",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  }
}
