{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "sovereign-deny-all",
    "labels": {
      "app.kubernetes.io/part-of": "sovereign-ai-101",
      "sovereign.ai/source": "REHEARSAL",
      "sovereign.ai/delivery": "development"
    }
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/part-of": "sovereign-ai-101"
      }
    },
    "policyTypes": [
      "Ingress",
      "Egress"
    ],
    "ingress": [],
    "egress": []
  }
}
